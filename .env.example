# ============================================================================
# MODELO DE CONFIGURACAO - SIMULADOR EV OCPP 1.6J
# ============================================================================
# Copie este arquivo para .env e altere pelo menos CHARGE_POINT_ID,
# CHARGER_SERIAL_NUMBER e ID_TAG.
#
# O CSMS da Inovative aceita conexoes sem senha no modo atual de testes.
# Portanto CSMS_PASSWORD foi removido deste modelo.

# Identidade unica do carregador no CSMS e na URL OCPP.
CHARGE_POINT_ID=SIM-001

# URL base do gateway OCPP.
CSMS_URL=wss://mobi-ocpp.inovative.cloud

# true gera a URL final CSMS_URL/CHARGE_POINT_ID.
# Exemplo: wss://mobi-ocpp.inovative.cloud/SIM-001
APPEND_CHARGE_POINT_ID_TO_URL=true

# Conector unico simulado.
CONNECTOR_ID=1

# Identificador utilizado em Authorize e StartTransaction.
ID_TAG=SIMULATOR001

# Informacoes enviadas no BootNotification.
CHARGER_VENDOR=Inovative
CHARGER_MODEL=EV-Simulator
CHARGER_SERIAL_NUMBER=SIM-001
CHARGER_FIRMWARE_VERSION=0.1.0

# Caracteristicas eletricas do carregador AC.
CHARGER_TYPE=AC
MAX_POWER_KW=22
VOLTAGE=380
PHASES=3
POWER_FACTOR=0.98

# Estado inicial e meta da bateria do veiculo.
VEHICLE_BATTERY_KWH=60
VEHICLE_INITIAL_SOC=30
VEHICLE_TARGET_SOC=90

# false deixa a recarga sob controle da interface web.
AUTO_START_TRANSACTION=false
AUTO_START_DELAY_SECONDS=5

# Periodicidade de telemetria e heartbeat, em segundos.
METER_INTERVAL_SECONDS=10
HEARTBEAT_INTERVAL_SECONDS=60

# Politica de reconexao exponencial.
RECONNECT_INTERVAL_SECONDS=5
RECONNECT_MAX_INTERVAL_SECONDS=60

# Timeout de chamadas OCPP e nivel de detalhamento dos logs.
OCPP_CALL_TIMEOUT_SECONDS=30
LOG_LEVEL=info

# Interface web: 8080 no container e 8085 no computador local.
WEB_PORT=8080
WEB_HOST_PORT=8085

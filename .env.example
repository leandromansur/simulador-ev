# ---------------------------------------------------------------
# Simulador EV OCPP 1.6J - copie para .env (nao versionado)
# ---------------------------------------------------------------

# Identificacao do Charge Point (obrigatorio)
CHARGE_POINT_ID=SIM-001

# Endpoint do CSMS (obrigatorio). ws:// ou wss://
# CSMS rodando no Windows host: host.docker.internal
CSMS_URL=ws://host.docker.internal:9000/ocpp

# true  -> URL final = CSMS_URL/CHARGE_POINT_ID  (padrao OCPP 1.6J)
# false -> URL final = CSMS_URL
APPEND_CHARGE_POINT_ID_TO_URL=true

# Conector simulado
CONNECTOR_ID=1

# idTag usado em Authorize/StartTransaction locais
ID_TAG=SIMULATOR001

# Dados enviados no BootNotification
CHARGER_VENDOR=Inovative
CHARGER_MODEL=EV-Simulator
CHARGER_SERIAL_NUMBER=SIM-001
CHARGER_FIRMWARE_VERSION=0.1.0

# Carregador (somente AC no MVP)
CHARGER_TYPE=AC
MAX_POWER_KW=22
# Tensao de linha (fase-fase) em V para trifasico; fase-neutro para monofasico
VOLTAGE=380
PHASES=3
POWER_FACTOR=0.98

# Veiculo simulado
VEHICLE_BATTERY_KWH=60
VEHICLE_INITIAL_SOC=30
VEHICLE_TARGET_SOC=90

# Temporizacao
METER_INTERVAL_SECONDS=10
HEARTBEAT_INTERVAL_SECONDS=60
# Backoff: base * 2^n, limitado ao maximo
RECONNECT_INTERVAL_SECONDS=5
RECONNECT_MAX_INTERVAL_SECONDS=60
OCPP_CALL_TIMEOUT_SECONDS=30

# debug | info | warn | error
LOG_LEVEL=debug

# true: apos Boot aceito, conecta o veiculo, autoriza e inicia a transacao sozinho
AUTO_START_TRANSACTION=false
AUTO_START_DELAY_SECONDS=5

# Interface web (dentro do container). 0 desativa.
# No host ela fica em http://localhost:WEB_HOST_PORT (somente 127.0.0.1)
WEB_PORT=8080
WEB_HOST_PORT=8085

# ============================================================================
# MODELO - SEGUNDO SIMULADOR EV OCPP 1.6J
# ============================================================================
# Copie este arquivo para .env.simulator-02.
# O Compose separado expoe a interface em http://localhost:8086.
#
# O modo atual de testes nao usa CSMS_PASSWORD.

# Identidade exclusiva do segundo simulador.
CHARGE_POINT_ID=charger-test-02

# URL base do CSMS; a identidade sera anexada automaticamente.
CSMS_URL=wss://mobi-ocpp.inovative.cloud
APPEND_CHARGE_POINT_ID_TO_URL=true

# Identificador usado para autorizar a transacao.
ID_TAG=TAG-SMOKE-02

# Inicia a recarga automaticamente apos BootNotification.
AUTO_START_TRANSACTION=true
